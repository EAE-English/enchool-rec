{"id": "n06_r2", "book": "Word Up 800", "unit": "Review 2", "title": "The Summer Music Festival", "s": [{"en": "Come to our amazing summer music *festival*!", "ref": "우리의 멋진 여름 음악 축제에 오세요!"}, {"en": "It starts *tomorrow* in Central Park.", "ref": "축제는 내일 센트럴 파크에서 시작해요."}, {"en": "At the festival, you can see rock bands *perform* live music.", "ref": "축제에서 록 밴드들이 라이브 음악을 공연하는 것을 볼 수 있어요."}, {"en": "There will be a colorful *parade* too.", "ref": "화려한 퍼레이드도 있을 거예요."}, {"en": "If you get hungry, don't worry.", "ref": "배가 고파져도 걱정하지 마세요."}, {"en": "There will be food trucks *along* the *street*.", "ref": "길을 따라 푸드 트럭들이 있을 거예요."}, {"en": "You can try different foods from around *town*.", "ref": "마을 곳곳의 다양한 음식을 먹어 볼 수 있어요."}, {"en": "You can also *buy* all kinds of *goods* and *items* from the outdoor market.", "ref": "야외 시장에서 온갖 종류의 상품과 물건도 살 수 있어요."}, {"en": "The sellers have great *prices*.", "ref": "판매자들은 아주 좋은 가격에 팔아요."}, {"en": "And if you like sports, please visit the *corner* of the *park*.", "ref": "그리고 스포츠를 좋아한다면, 공원 모퉁이에 가 보세요."}, {"en": "You can play soccer or *badminton* there with your friends.", "ref": "거기에서 친구들과 축구나 배드민턴을 할 수 있어요."}, {"en": "The festival is free for everyone, so don't miss it!", "ref": "축제는 모두에게 무료이니 놓치지 마세요!"}], "w": {"festival": "축제", "tomorrow": "내일", "perform": "공연하다", "parade": "퍼레이드, 행진", "along": "~을 따라", "street": "길, 거리", "town": "마을, 소도시", "buy": "사다", "goods": "상품, 물건", "items": "물건, 품목", "prices": "가격", "corner": "모퉁이, 구석", "park": "공원", "badminton": "배드민턴"}, "g": {"a": "하나의 (보통 해석 안 해요)", "all": "모든, 모두", "also": "또한, ~도", "amazing": "멋진, 놀라운", "and": "그리고", "around": "~ 곳곳에, 주위에", "at": "~에서", "bands": "밴드들 (band 밴드)", "be": "~이다, 있다 (will be ~일 것이다)", "can": "~할 수 있다", "central": "중앙의 (Central Park 센트럴 파크)", "colorful": "화려한, 알록달록한", "come": "오다", "different": "다양한, 서로 다른", "don't": "~하지 마 (do not)", "everyone": "모두, 여러분", "food": "음식 (food truck 푸드 트럭)", "foods": "음식들", "for": "~에게, ~을 위해", "free": "무료의", "friends": "친구들", "from": "~에서, ~로부터", "get": "(get hungry) 배가 고파지다", "great": "아주 좋은", "have": "가지고 있다", "hungry": "배고픈", "if": "만약 ~라면", "in": "~에, ~안에", "is": "~이다", "it": "그것 (여기서는 축제)", "kinds": "종류들 (all kinds of 온갖 종류의)", "like": "좋아하다", "live": "라이브의, 실제 공연의", "market": "시장", "miss": "놓치다", "music": "음악", "of": "~의", "or": "또는", "our": "우리의", "outdoor": "야외의", "play": "(운동을) 하다", "please": "(부탁할 때) ~해 주세요", "rock": "록 (음악)", "see": "보다", "sellers": "판매자들, 파는 사람들", "so": "그래서, 그러니", "soccer": "축구", "sports": "스포츠, 운동", "starts": "시작하다 (start)", "summer": "여름", "the": "그 (보통 해석 안 해요)", "there": "(There will be ~) ~이 있을 것이다 / 거기에서", "to": "~에, ~로", "too": "~도, 또한", "trucks": "트럭들", "try": "먹어 보다, 해 보다", "visit": "가 보다, 방문하다", "will": "~할 것이다", "with": "~와 함께", "worry": "걱정하다", "you": "너, 여러분", "your": "너의, 여러분의"}, "nog": []}